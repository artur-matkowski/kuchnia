# Everything scripts/build.sh writes, one directory per target. Nothing else may write
# here, so an entry per artifact would be noise: the directory is the artifact.
/build/

# An in-tree cmake run, which nothing here asks for but everyone does once.
/CMakeCache.txt
/CMakeFiles/
/kuchnia
config.conf
# A local agent's workspace. Not this project's, and never committed.
/.opencode/

# dpkg-buildpackage's working tree and the artifact scripts/build-deb.sh collects. The
# obj- directory is named for the host architecture, so it is matched rather than listed.
/obj-*/
/debian/.debhelper/
/debian/kuchnia/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
/dist/

# The capture directory. One run per directory, and the report beside its log.
/logs/

# The screen recording demo/kuchnia.gif is made from, and any cut of it made for somewhere
# else. The GIF is the only one of the three small enough to belong in every clone.
/demo/*.mkv
/demo/*.mp4

# The container's own state, which is not the container. Each of these is a bind mount from
# services/docker-compose.yml, kept in the repository so that throwing the deployment away is
# `rm -rf` here rather than a hunt through /var/lib/docker.
#
# services/data/ holds the harvested cookie jar, and THAT FILE IS THE GOOGLE CREDENTIAL.
/services/data/
/services/profile/
/services/cache/
/services/.env

# Nothing here is a Python package, but services/app is Python and running it leaves these.
# scripts/__pycache__ is tracked by an accident this prevents.
__pycache__/
*.pyc
