# Copy to scripts/toolchain.cmake and edit. Never committed: every path in it belongs to
# one machine, and .gitignore keeps it out.
#
# A Buildroot tree generates a complete toolchain file already. Including it rather than
# restating a compiler, a sysroot and a set of flags is what keeps this file from
# describing a toolchain the tree no longer has.
include(/home/you/projekty/linux/output/host/share/buildroot/toolchainfile.cmake)

# Qt cross-builds run host tools - moc, rcc, qmlcachegen, qmlimportscanner - and they are
# not in the toolchain file, because Buildroot does not know this project is a Qt one.
# Without QT_HOST_PATH the configure step fails naming the Qt6 package and not the reason.
set(QT_HOST_PATH /home/you/projekty/linux/output/host CACHE PATH "")
