#!/usr/bin/make -f

# DEB_BUILD_ARCH, DEB_HOST_ARCH and DEB_BUILD_MULTIARCH, used below.
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# cmake+ninja rather than cmake: the default generator is recursive make, which serialises
# at every target boundary, and ninja-build is already a Build-Depends.
%:
	dh $@ --buildsystem=cmake+ninja

# Qt puts an $ORIGIN RUNPATH on anything it installs. From /usr/bin it resolves to the
# multiarch directory the loader already searches, so it buys nothing and adds /usr/bin to a
# system binary's library search path.
CONFIGURE_OPTS = -DCMAKE_SKIP_INSTALL_RPATH=ON

# The version the settings screen prints. Taken from debian/changelog, which is the version
# dpkg-buildpackage stamps the package with and therefore the one apt installed - anything
# derived from git here would name a commit nobody can look up from a board.
CONFIGURE_OPTS += -DKUCHNIA_VERSION=$(shell dpkg-parsechangelog -S Version)

# Qt runs moc, rcc, qmlcachegen and qmlimportscanner on the build machine and the CMake
# toolchain knows nothing about them. On Debian the host Qt's CMake package does not sit at
# ${QT_HOST_PATH}/lib/cmake, so naming the prefix alone is not enough - see docs/targets.md.
ifneq ($(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))
CONFIGURE_OPTS += -DQT_HOST_PATH=/usr \
                  -DQT_HOST_PATH_CMAKE_DIR=/usr/lib/$(DEB_BUILD_MULTIARCH)/cmake
endif

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIGURE_OPTS)

# There is no test suite, and an arm64 binary could not be run here if there were. The make
# generator probed for a `test` target and skipped when it found none; ninja does not probe,
# and `ninja test` is an error that fails the package rather than a no-op.
override_dh_auto_test:
