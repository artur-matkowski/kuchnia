[Unit]
Description=Qt Quick HMI on DRM/KMS
# Every client backs off and retries on its own, so nothing here waits for a route.
After=network.target
# A display manager owns the CRTC, and eglfs cannot take one that is already held.
Conflicts=lightdm.service

[Service]
Type=simple
ExecStart=/usr/bin/qt-hmi
Restart=always
RestartSec=2

User=qt-hmi
SupplementaryGroups=video render input

# Debian's Qt has no image-wide default QPA to inherit, and the console already put a mode
# on the CRTC that Qt would otherwise keep - a correct picture at the wrong size.
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_HIDECURSOR=1

# The V4L2 H.264/H.265 decoders, stateful and stateless both, are ranked out of the way so
# the camera tiles decode in software. Ranked, not removed - gstreamer still loads them and
# simply never picks them. Empirical, and carried from the deployment this replaces.
Environment=GST_PLUGIN_FEATURE_RANK=v4l2h264dec:NONE,v4l2h265dec:NONE,v4l2slh264dec:NONE,v4l2slh265dec:NONE

# QSettings has nowhere to write for a system user with no home, and both writers report it
# only after the fact. See docs/packaging.md.
StateDirectory=qt-hmi
Environment=XDG_CONFIG_HOME=/var/lib/qt-hmi

[Install]
WantedBy=multi-user.target
