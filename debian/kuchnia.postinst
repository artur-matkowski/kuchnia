#!/bin/sh
set -e

case "$1" in
	configure)
		# A group and no account: the application runs as whoever is logged into the
		# session, and this is only what guards the passwords in the file below.
		if ! getent group kuchnia >/dev/null; then
			addgroup --system kuchnia
		fi

		# The passwords live in this file, and it is read by the session user.
		chown root:kuchnia /etc/kuchnia.conf
		chmod 0640 /etc/kuchnia.conf

		# The one step this script cannot infer - it does not know which account autologs in,
		# and reading it out of the display manager's config would be a guess. Without it the
		# file is unreadable and the application runs on compiled-in defaults, saying so only
		# at warning level. See docs/packaging.md.
		echo "kuchnia: the account that runs the session must be in the kuchnia group:"
		echo "kuchnia:     sudo adduser <user> kuchnia"

		# snapclient is a Depends, and its own package starts and enables the unit. That
		# unit is a SECOND snapclient - user _snapclient, empty SNAPCLIENT_OPTS so it
		# browses mDNS for whatever server it finds, no PULSE_SERVER, and outside this
		# application's mute arbitration. Nothing else on the board uses it, which is
		# exactly why nothing but the application may start one.
		#
		# dpkg configures a Depends before its dependent, so this always runs second, and
		# deb-systemd-helper remembers the disable across snapclient's own upgrades.
		if [ -d /run/systemd/system ]; then
			systemctl disable --now snapclient.service >/dev/null 2>&1 || true
		fi
		;;
esac

#DEBHELPER#
