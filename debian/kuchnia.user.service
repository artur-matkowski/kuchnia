[Unit]
Description=Kuchnia, the house dashboard
# Ordering only, and on this board it orders against a target that never activates - see
# docs/packaging.md. What actually starts this unit is the XDG autostart entry.
After=graphical-session.target

[Service]
Type=simple

# Takes the three audio keys back off the compositor, which otherwise consumes them before any
# client sees them. Prefixed with '-' on purpose: the panel starting matters more than the
# volume keys, so a failure here is a journal line and not a unit that will not come up. It
# writes nothing once the file is in place - see docs/session.md.
ExecStartPre=-/usr/libexec/kuchnia-session-keys

ExecStart=/usr/bin/kuchnia
Restart=always
RestartSec=2

# The sound server on this board is system-wide and shared with another service, so it is not
# the per-user one Qt looks for by default. See docs/media.md.
Environment=PULSE_SERVER=unix:/run/pipewire/pulse-native

# QT_QPA_PLATFORM is deliberately unset: the plugin follows the session, so one unit serves
# the labwc session and the X one beside it. Setting it here would pick for both.

[Install]
WantedBy=graphical-session.target
